t.%29.png/22px-H._Schlangenm._%28herst.%29.png\" width=\"22\"/></span></span> <a data-w=\"H._Schlangenm._(herst.)\">H. Schlangenm. (herst.)</a></li> <li><span> <span><img alt=\"R. Schlangenm. (herst.).png\" height=\"22\" loading=\"lazy\" src=\"https://de-wiki.metin2.gameforge.com/images/thumb/2/26/R._Schlangenm._%28herst.%29.png/22px-R._Schlangenm._%28herst.%29.png\" width=\"22\"/></span></span> <a data-w=\"R._Schlangenm._(herst.)\">R. Schlangenm. (herst.)</a></li> <li><span> <span><img alt=\"Schlangenmantel (herst.).png\" height=\"22\" loading=\"lazy\" src=\"https://de-wiki.metin2.gameforge.com/images/thumb/5/58/Schlangenmantel_%28herst.%29.png/22px-Schlangenmantel_%28herst.%29.png\" width=\"22\"/></span></span> <a data-w=\"Schlangenmantel_(herst.)\">Schlangenmantel (herst.)</a></li> <li><span> <span><img alt=\"Schlangenwams (herst.).png\" height=\"22\" loading=\"lazy\" src=\"https://de-wiki.metin2.gameforge.com/images/thumb/f/f6/Schlangenwams_%28herst.%29.png/22px-Schlangenwams_%28herst.%29.png\" width=\"22\"/></span></span> <a data-w=\"Schlangenwams_(herst.)\">Schlangenwams (herst.)</a></li></ul> </div> </div>"}